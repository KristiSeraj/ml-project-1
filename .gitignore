# Environment — never committed
.venv/
venv/
env/
__pycache__/
*.py[cod]
.python-version

# Data — raw is read-only and external, processed is regenerated by code
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Artefacts — output, not source
models/*
!models/.gitkeep

# Figures are regenerated by src/evaluate.py; keep the folder, drop the files
reports/figures/*
!reports/figures/.gitkeep

# Notebook noise
.ipynb_checkpoints/

# Editors and OS
.idea/
.vscode/
.DS_Store
